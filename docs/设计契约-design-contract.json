{
  "schema_version": "6.0",
  "task": {
    "title": "巧手猜图网页化设计方案",
    "source_text": "用户：你知道巧手猜图这个桌游吗？如果把它转换成网页游戏，你觉得怎么样；出一份网页化设计方案。补充：我希望这个游戏如果联机的话，最少两个人就能玩；如果本地就一个玩家的话，他可以先拼图然后生成图片分享给其他人猜。讨论一下这个改进合理吗？你可以优化我的建议然后加进设计方案里。",
    "readiness_target": "prototype",
    "flags": {
      "capacity": false,
      "handoff": true,
      "html": true,
      "lifecycle": true,
      "numbers": true,
      "persistence": false,
      "probability": true,
      "production": true,
      "resources": false,
      "scope_constraints": true
    }
  },
