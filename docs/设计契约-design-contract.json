    {
      "id": "RISK-CANVAS-PERF",
      "surface": "performance",
      "trigger": "画布元素上限 60、低端移动端重绘、多人在线同屏",
      "impact": "拖拽卡顿、绘制延迟",
      "detection": "元素数 60 时的帧率与拖拽延迟基准",
      "mitigation": "元素上限 60；脏矩形按需重绘；静态预览降级",
      "fallback": "作品渲染降级为预渲染位图",
      "owner": "program"
    },
    {
      "id": "RISK-CONCURRENCY",
      "surface": "network_concurrency",
      "trigger": "多人同时提交创作与投票、超时与提交同帧、断线重连",
      "impact": "结算重复、状态漂移、作品丢失",
      "detection": "同帧并发与断线恢复回归集",
      "mitigation": "服务端权威状态机；事件按玩家+阶段幂等去重",
      "fallback": "房间重建并从最后快照恢复",
      "owner": "program and qa"
    },
    {
      "id": "RISK-CONTENT",
      "surface": "content_pipeline",
      "trigger": "照片池 60 张上线、版权合规、可抽象性参差",
      "impact": "版权风险、部分照片无法表达或过于直白",
      "detection": "每张照片人工过筛并标注主特征",
      "mitigation": "仅用 CC0/自摄/自生成素材；特征标签随照片入库",
      "fallback": "不合格照片从池中下架",
      "owner": "content"
    },
    {
      "id": "RISK-UI-TOUCH",
      "surface": "ui_input",
      "trigger": "移动端拖拽旋转缩放手势、猜测阶段误触",
      "impact": "误操作、猜错提交",
      "detection": "手机真机走查创作与猜测完整路径",
      "mitigation": "单指拖拽、双指旋缩；投票提交前二次确认",
      "fallback": "猜测提交 3 秒内可撤回",
      "owner": "program and qa"
    }
  ],
