  "assumptions": [
    {
      "id": "ASM-DEVICES",
      "statement": "每名玩家一台设备（手机或电脑），同房或远程均可加入同一房间",
      "impact": "high",
      "status": "confirmed",
      "validation": "在线房间制同时覆盖同房聚会与远程联机两个场景"
    },
    {
      "id": "ASM-GUESS-RATE",
      "statement": "猜中率落在 [25%, 70%] 说明抽象表达既可推断又不直白",
      "impact": "high",
      "status": "test_value",
      "validation": "P0 真人试玩统计每轮猜中率，偏离区间时调整照片特征与工具限制"
    },
    {
      "id": "ASM-TOOLKIT-COUNT",
      "statement": "五套工具对应原版五套组件，5 轮内每人用满每套一次",
      "impact": "high",
      "status": "confirmed",
      "validation": "原版五套组件：鞋带、彩色立方体、图标卡、棍棒和石头、积木"
    }
  ],
  "rules": [
    {
      "id": "RULE-BOARD",
      "title": "照片墙与坐标",
      "definition": "每轮从照片池无放回抽取 16 张，排成 4x4 方阵；行标 A-D、列标 1-4，坐标形如 B3。",
      "priority": "P0",
      "parameter_ids": [
        "PAR-PHOTO-COUNT"
      ],
      "state_machine_ids": [
        "SM-ROOM"
      ],
      "authority_ids": [
        "ALLOW-CORE-BOARD"
      ],
      "fields": [
        "core.board_grid"
      ]
    },
    {
      "id": "RULE-DEAL",
      "title": "秘密抽题",
      "definition": "每位玩家从 16 个坐标无放回秘密抽取 1 个，锁定自己的目标照片；目标在猜测揭晓前对他人保密。",
      "priority": "P0",
      "parameter_ids": [
        "PAR-PHOTO-COUNT"
      ],
      "state_machine_ids": [
        "SM-ROOM"
      ],
      "authority_ids": [
        "ALLOW-CORE-DEAL"
      ],
      "fields": [
        "core.secret_deal"
      ]
    },
    {
      "id": "RULE-TOOLKIT",
      "title": "工具分配与轮换",
      "definition": "5 套工具按固定序列 [曲线、方块、图标、棒石、积木] 轮换；每轮每位玩家使用 1 套；N 小于 5 时当轮按序列取 N 套，下轮平移一位。",
      "priority": "P0",
      "parameter_ids": [
        "PAR-TOOLKIT-COUNT"
      ],
      "state_machine_ids": [
        "SM-ROOM"
      ],
      "authority_ids": [
        "ALLOW-CORE-ROTATION"
      ],
      "fields": [
        "core.tool_rotation"
      ]
    },
    {
      "id": "RULE-CREATE",
      "title": "创作阶段",
      "definition": "创作阶段限时（默认 150 秒），玩家用所持工具在私有画布拼出目标照片的抽象表达；禁止导入图片与自由绘画（鞋带套除外）；单作品元素上限 60。",
      "priority": "P0",
      "parameter_ids": [
        "PAR-CREATE-SECONDS",
        "PAR-ELEMENT-CAP"
      ],
      "state_machine_ids": [
        "SM-ROOM"
      ],
      "authority_ids": [
        "ALLOW-TIMER",
        "ALLOW-CORE-TOOLKIT"
      ],
      "fields": [
        "rule.timer",
        "core.toolkit_abstraction"
      ]
    },
    {
      "id": "RULE-SUBMIT",
      "title": "提交与锁定",
      "definition": "时间到自动锁定并提交；玩家也可提前提交；已提交作品不可修改。",
      "priority": "P0",
      "state_machine_ids": [
        "SM-ROOM"
      ],
      "authority_ids": [
        "ALLOW-TIMER"
      ],
      "fields": [
        "rule.timer"
      ]
    },
    {
      "id": "RULE-GUESS",
      "title": "猜测阶段",
      "definition": "猜测阶段（默认 60 秒）每位玩家为每个他人作品选 1 个坐标，可跳过；提交后不可修改。",
      "priority": "P0",
      "parameter_ids": [
        "PAR-GUESS-SECONDS"
      ],
      "state_machine_ids": [
        "SM-ROOM"
      ],
      "authority_ids": [
        "ALLOW-CORE-SCORE"
      ],
      "fields": [
        "core.scoring_1"
      ]
    },
    {
      "id": "RULE-SCORE",
      "title": "计分",
      "definition": "猜中他人作品 +1；自己作品每被猜中 1 次 +1；跳过或猜错 0 分且不扣分。",
      "priority": "P0",
      "state_machine_ids": [
        "SM-ROOM"
      ],
      "authority_ids": [
        "ALLOW-CORE-SCORE"
      ],
      "fields": [
        "core.scoring_1"
      ]
    },
    {
      "id": "RULE-ROUNDS",
      "title": "轮次与胜负",
      "definition": "默认 5 轮，房主可配置 3-5 轮；终局总分最高者胜，平局并列。",
      "priority": "P0",
      "parameter_ids": [
        "PAR-ROUNDS"
      ],
      "state_machine_ids": [
        "SM-ROOM"
      ],
      "authority_ids": [
        "ALLOW-CORE-ROTATION"
      ],
      "fields": [
        "core.tool_rotation"
      ]
    },
    {
      "id": "RULE-RECONNECT",
      "title": "断线恢复",
      "definition": "玩家断线后保留会话与当前阶段快照；创作阶段保留本地草稿，猜测阶段保留已投记录；2 分钟内重连返回当前阶段，超时按掉线处理，本轮按跳过结算、下一轮不参与发题。",
      "priority": "P0",
      "authority_ids": [
        "ALLOW-RECONNECT"
      ],
      "fields": [
        "networking.reconnect"
      ]
    },
    {
      "id": "RULE-MIN-PLAYERS",
      "title": "联机人数下限",
      "definition": "实时局房主开始的门槛为在线人数 ≥ 2，2 人即可开局；推荐 3-6 人。",
      "priority": "P0",
      "parameter_ids": [
        "PAR-PLAYERS"
      ],
      "state_machine_ids": [
        "SM-ROOM"
      ],
      "authority_ids": [
        "ALLOW-MIN-2"
      ],
      "fields": [
        "networking.min_players"
      ]
    },
    {
      "id": "RULE-SOLO",
      "title": "单人出题模式",
      "definition": "单人玩家进创作流：系统配 16 张照片墙并秘密抽 1 个坐标、随机分一套工具；创作提交后生成分享链接（默认）与作品图导出（可选）；任何人点开链接免注册即可看作品与照片墙并选 1 个坐标猜，提交前不见他人答案，猜完揭晓对错；作者累计被猜中次数。",
      "priority": "P0",
      "parameter_ids": [
        "PAR-PHOTO-COUNT"
      ],
      "authority_ids": [
        "ALLOW-SOLO"
      ],
      "fields": [
        "gameplay.solo_mode"
      ]
    }
  ],
